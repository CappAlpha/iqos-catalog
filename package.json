{
  "name": "iqos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "build:capacitor": "tsc -b && vite build --mode capacitor && npx cap sync",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "preview": "vite preview",
    "lint-staged": "lint-staged",
    "prepare-pre-commit": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,scss}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "dependencies": {
    "@bprogress/core": "^1.3.4",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/file-transfer": "^2.0.5",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capawesome-team/capacitor-file-opener": "^8.0.2",
    "@leeskies/capacitor-usb-serial": "^0.2.0",
    "@tanstack/query-core": "^5.101.4",
    "axios": "^1.19.0",
    "currency.js": "^2.0.4",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "mobx-tanstack-query": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.0",
    "clsx": "^2.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mobx": "^0.0.14",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "oxc-transform-react": "^0.145.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.102.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
